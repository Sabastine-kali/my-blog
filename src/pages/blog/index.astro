---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<h1>Blog</h1>

<p>Learn how to improve your career, resumes, and digital skills.</p>

<ul>
  {posts.map((post) => (
    <li>
      <a href={`/blog/${post.slug}/`}>
        {post.data.title}
      </a>
      <p>{post.data.pubDate}</p>
    </li>
  ))}
</ul>
