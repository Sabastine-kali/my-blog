---
import { getCollection } from 'astro:content';

// get all blog posts
const posts = await getCollection('blog');

// sort newest first
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
);

// latest post
const latestPost = sortedPosts[0];
---

