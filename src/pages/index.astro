---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';

// get all blog posts
const posts = await getCollection('blog');

// sort safely (prevents undefined crash)
const sortedPosts = posts
  .filter(post => post.data?.pubDate)
  .sort(
    (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
  );

// safe latest post check
const latestPost = sortedPosts.length > 0 ? sortedPosts[0] : null;
---

<Header />

<main style="max-width: 800px; margin: auto; padding: 20px;">

  <h1>Welcome to Career Growth Hub</h1>

  <p>
    We publish practical guides to help you build better resumes,
    grow your skills, and increase your income with digital products.
  </p>

  <hr />

  <h2>🔥 Latest Article</h2>

  {latestPost ? (
    <>
      <a href={`/blog/${latestPost.slug}/`}>
        <h3>{latestPost.data.title}</h3>
      </a>

      <p>{latestPost.data.description}</p>

      <a href={`/blog/${latestPost.slug}/`}>
        👉 Read Full Article
      </a>
    </>
  ) : (
    <p>No articles yet.</p>
  )}

  <hr />

  <h2>📂 Explore Topics</h2>

  <ul>
    <li>
      <strong>ATS Resume System</strong><br />
      Learn how to pass ATS filters and get more interviews.<br />
      <a href="/ats-resume">Go to ATS Resume Kit →</a>
    </li>

    <br />

    <li>
      <strong>All Blog Posts</strong><br />
      Browse career growth and digital income articles.<br />
      <a href="/blog">View Blog →</a>
    </li>
  </ul>

  <hr />

  <h2>💼 Featured Product</h2>

  <p>
    ATS Resume Kit PRO helps you create ATS-optimized resumes that pass recruiter filters.
  </p>

  <a href="/ats-resume">
    👉 Get ATS Resume Kit PRO
  </a>

  <footer style="margin-top: 40px;">
    <p>© 2026 Career Growth Hub</p>
  </footer>

</main>
