---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';

// Get all blog posts
const posts = await getCollection('blog');

// Keep only valid posts (prevents undefined errors)
const validPosts = posts.filter(
  (post) => post.slug && post.data?.pubDate && post.data?.title
);

// Sort newest first
const sortedPosts = validPosts.sort(
  (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
);

// Latest post safely
const latestPost = sortedPosts.length > 0 ? sortedPosts[0] : null;
---

<Header />

<main style="max-width: 800px; margin: auto; padding: 20px;">

  <h1>Welcome to Career Growth Hub</h1>

  <p>
    We publish practical guides to help you improve your career,
    write better resumes, and grow your income with digital products.
  </p>

  <hr />

  <h2>🔥 Latest Article</h2>

  {latestPost ? (
    <a href={`/blog/${latestPost.slug}/`} style="display: block;">
      <h3>{latestPost.data.title}</h3>
      <p>{latestPost.data.description}</p>
      👉 Read Full Article
    </a>
  ) : (
    <p>No articles available yet.</p>
  )}

  <hr />

  <h2>📂 Explore Topics</h2>

  <ul>
    <li>
      <strong>ATS Resume System</strong><br />
      Learn how to pass ATS filters and get more interviews.<br />
      <a href="/ats-resume">Go to ATS Resume Kit →</a>
    </li>

    <br />

    <li>
      <strong>Blog</strong><br />
      Explore all career and digital growth articles.<br />
      <a href="/blog">View All Posts →</a>
    </li>
  </ul>

  <hr />

  <h2>💼 Featured Product</h2>

  <p>
    ATS Resume Kit PRO helps you build ATS-optimized resumes that get you more interview calls.
  </p>

  <a href="/ats-resume">
    👉 Get ATS Resume Kit PRO
  </a>

  <footer style="margin-top: 40px;">
    <p>© 2026 Career Growth Hub. All rights reserved.</p>
  </footer>

</main>
