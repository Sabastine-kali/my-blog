---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

// sort newest first
const latestPost = posts.sort(
  (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
)[0];
---

<h1>Welcome to Career Growth Hub</h1>

<p>
Learn how to create ATS-friendly resumes, get more interviews, and improve your job success.
</p>

<hr />

<h2>🔥 Latest Article</h2>

<a href={`/blog/${latestPost.slug}/`}>
  <h3>{latestPost.data.title}</h3>
</a>

<p>{latestPost.data.description}</p>

<a href={`/blog/${latestPost.slug}/`}>
  👉 Read Full Article
</a>

<hr />

<h2>💼 ATS Resume Kit PRO</h2>

<p>
A complete system to help you pass ATS filters and get more interviews.
</p>

